{
  "extends": "expo/tsconfig",
  "compilerOptions": {
    "jsx": "react-native",
    "jsxImportSource": "react",
    "lib": ["ES2020"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["react-native"]
  }
}
